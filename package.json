{
  "name": "journal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && node scripts/electron.mjs",
    "start": "electron .",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "description": "A local-first Markdown journal with daily notes and a task list that carries itself forward.",
  "author": {
    "name": "Mateusz Łysień",
    "email": "mateusz.lysien@homeverest.pl"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "app.journal.desktop",
    "productName": "Journal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icons",
      "maintainer": "Mateusz Łysień <mateusz.lysien@homeverest.pl>",
      "desktop": {
        "Name": "Journal",
        "Comment": "Markdown journal with daily notes and tasks",
        "StartupWMClass": "journal"
      }
    },
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
